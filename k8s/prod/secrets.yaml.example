apiVersion: v1
kind: Secret
metadata:
  name: spiritblade-secrets
  namespace: prod
type: Opaque
data:
  # Debe coincidir con adb_admin_password en terraform.tfvars
  adb-password: 
  
  # OCI Object Storage credentials
  # Access Key ID de OCI (Customer Secret Keys)
  oci-storage-access-key:
  
  # Secret Key de OCI (Customer Secret Keys)
  oci-storage-secret-key:
  riot-api-key: 
  
  google-ai-api-key: 
  ssl-password:
